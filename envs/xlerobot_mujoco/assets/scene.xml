<!-- Loadable scene for the placeholder robot. The env opens this file. -->
<mujoco model="xlerobot_scene">
  <include file="xlerobot_placeholder.xml"/>

  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>
  <statistic center="0 0 0.3" extent="1"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.35 0.35 0.35" specular="0 0 0"/>
  </visual>

  <asset>
    <texture type="2d" name="groundplane" builtin="checker" rgb1="0.2 0.3 0.2" rgb2="0.3 0.4 0.3" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="4 4"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="2 2 0.1" material="groundplane"/>
    <camera name="overview" mode="targetbody" target="chassis" pos="0.9 -0.9 0.7"/>
  </worldbody>
</mujoco>
